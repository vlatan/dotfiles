
# get cheat sheet for a command
cht() {
	curl cht.sh/$1
}

# update the repos and upgrade
sysupdate() {
	sudo apt update && sudo apt upgrade;
	command -v snap &> /dev/null && sudo snap refresh;
	command -v flatpak &> /dev/null && flatpak update -y;
	sudo apt autoremove;
	sudo apt autoclean
}


dclog() {
	local service="$1"
    local tail="${2:-10}" # Defaults to 10 if not provided
	docker compose logs -f --tail="$tail" --no-log-prefix --no-color "$service" | while read -r line; do
		if echo "$line" | jq -e . >/dev/null 2>&1; then
			echo "$line" | jq .
		else
			echo "$line"
		fi
	done
}

dcloglevel() {
local service="$1"
    local level="${2:-error}" # Defaults to error if not provided
    local tail="${3:-10}"     # Defaults to 10 if not provided
    docker compose logs -f --tail="$tail" --no-log-prefix --no-color "$service" | grep -i --line-buffered "$level" | while read -r line; do
        if echo "$line" | jq -e . >/dev/null 2>&1; then
            echo "$line" | jq .
        else
            echo "$line"
        fi
    done
}
